# PayPal Pulse AI — environment template.
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# All values below are placeholders.

# PayPal SANDBOX app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# false = use the real PayPal sandbox (needs the credentials above).
# true  = use the in-memory fake (default; honest demo data, no network).
USE_FAKE_PAYPAL=true

# Gemini API key for the AI investigation. When empty, the deterministic
# rule-based stub is used instead (still honest, still tested).
GEMINI_API_KEY=

# SQLite database path (shared by the payments store and the audit log).
PULSE_DB=./pulse.db
